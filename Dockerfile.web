FROM node:22-alpine AS frontend
WORKDIR /web
COPY src/frontend/package.web.json ./package.json
RUN npm install --ignore-scripts --no-audit --no-fund
COPY src/frontend ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HEALTHOS_FRONTEND_DIST=/app/web HEALTHOS_DATASET_PATH=/app/src/data/output/patients_dm2_synthetic.csv HEALTHOS_PORT=8080
WORKDIR /app
RUN addgroup --system healthos && adduser --system --ingroup healthos healthos
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY src ./src
COPY config ./config
COPY --from=frontend /web/dist ./web
USER healthos
EXPOSE 8080
CMD ["uvicorn", "src.backend.desktop_server:app", "--host", "0.0.0.0", "--port", "8080"]
